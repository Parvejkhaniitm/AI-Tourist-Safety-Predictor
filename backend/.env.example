FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
# SQLite is convenient for local development. Use PostgreSQL in deployment.
DATABASE_URL=sqlite:///saferoute.db
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
DEMO_DATA=true
# Plug in real providers when credentials and data licensing are available.
WEATHER_API_KEY=
MAPS_API_KEY=
